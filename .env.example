# ============================================
# KP Generator - РџРµСЂРµРјРµРЅРЅС‹Рµ РѕРєСЂСѓР¶РµРЅРёСЏ
# ============================================
# 
# РЎРєРѕРїРёСЂСѓР№С‚Рµ СЌС‚РѕС‚ С„Р°Р№Р» РІ .env Рё Р·Р°РїРѕР»РЅРёС‚Рµ СЃРІРѕРёРјРё Р·РЅР°С‡РµРЅРёСЏРјРё
# Р’РђР–РќРћ: РќРёРєРѕРіРґР° РЅРµ РєРѕРјРјРёС‚СЊС‚Рµ .env С„Р°Р№Р» РІ git!

# --------------------------------------------
# Flask РїСЂРёР»РѕР¶РµРЅРёРµ
# --------------------------------------------

# РЎРµРєСЂРµС‚РЅС‹Р№ РєР»СЋС‡ РґР»СЏ Flask СЃРµСЃСЃРёР№ (РіРµРЅРµСЂРёСЂСѓР№С‚Рµ СЃР»СѓС‡Р°Р№РЅС‹Р№)
# РџСЂРёРјРµСЂ РіРµРЅРµСЂР°С†РёРё: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-me

# Р РµР¶РёРј РѕС‚Р»Р°РґРєРё (true/false)
# Р’РќРРњРђРќРР•: Р’ production РѕР±СЏР·Р°С‚РµР»СЊРЅРѕ СѓСЃС‚Р°РЅРѕРІРёС‚Рµ false!
DEBUG=false
FLASK_DEBUG=false

# РЈСЂРѕРІРµРЅСЊ Р»РѕРіРёСЂРѕРІР°РЅРёСЏ (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# РџСЂРѕС„РёР»СЊ РѕРєСЂСѓР¶РµРЅРёСЏ (development, staging, production)
FLASK_ENV=production

# --------------------------------------------
# Р‘Р°Р·Р° РґР°РЅРЅС‹С…
# --------------------------------------------

# URL РїРѕРґРєР»СЋС‡РµРЅРёСЏ Рє Р‘Р”
# SQLite: sqlite:///kp_generator.db
# PostgreSQL: postgresql://user:password@localhost:5432/kp_generator
DATABASE_URL=sqlite:///kp_generator.db

# РќР°СЃС‚СЂРѕР№РєРё РїСѓР»Р° СЃРѕРµРґРёРЅРµРЅРёР№ (РґР»СЏ PostgreSQL/MySQL)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# --------------------------------------------
# OpenRouter AI API (РґР»СЏ AI РєРѕРЅСЃСѓР»СЊС‚Р°РЅС‚Р°)
# --------------------------------------------

# API РєР»СЋС‡ OpenRouter
# РџРѕР»СѓС‡РёС‚СЊ: https://openrouter.ai/keys
# РћР‘РЇР—РђРўР•Р›Р¬РќРћ: РЈСЃС‚Р°РЅРѕРІРёС‚Рµ Р»РёРјРёС‚С‹ Рё СЃСЂРѕРє РґРµР№СЃС‚РІРёСЏ РїСЂРё СЃРѕР·РґР°РЅРёРё РєР»СЋС‡Р°!
OPENROUTER_API_KEY=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

# РњРѕРґРµР»СЊ РґР»СЏ AI Р°РіРµРЅС‚Р°
# Р РµРєРѕРјРµРЅРґСѓРµРјС‹Рµ Р±РµСЃРїР»Р°С‚РЅС‹Рµ РјРѕРґРµР»Рё:
# - xiaomi/mimo-v2-flash:free (Р±С‹СЃС‚СЂР°СЏ, Р±РµСЃРїР»Р°С‚РЅР°СЏ)
# - meta-llama/llama-3.2-3b-instruct:free
# - google/gemma-2-9b-it:free
# РџР»Р°С‚РЅС‹Рµ РјРѕРґРµР»Рё (С‚СЂРµР±СѓСЋС‚ Р±Р°Р»Р°РЅСЃ):
# - anthropic/claude-3.5-sonnet
# - openai/gpt-4-turbo
OPENROUTER_MODEL=xiaomi/mimo-v2-flash:free

# Р’РєР»СЋС‡РёС‚СЊ reasoning РґР»СЏ РјРѕРґРµР»Рё (true/false)
OPENROUTER_REASONING_ENABLED=true

# Timeout РґР»СЏ Р·Р°РїСЂРѕСЃРѕРІ Рє API (СЃРµРєСѓРЅРґС‹)
OPENROUTER_TIMEOUT=60

# --------------------------------------------
# Redis (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ, РґР»СЏ РєРµС€РёСЂРѕРІР°РЅРёСЏ)
# --------------------------------------------

# Р’РєР»СЋС‡РёС‚СЊ Redis РєРµС€ (true/false)
REDIS_ENABLED=false

# РќР°СЃС‚СЂРѕР№РєРё РїРѕРґРєР»СЋС‡РµРЅРёСЏ Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# TTL РґР»СЏ РєРµС€Р° AI РѕС‚РІРµС‚РѕРІ (СЃРµРєСѓРЅРґС‹)
# 86400 = 24 С‡Р°СЃР°
AI_CACHE_TTL=86400

# --------------------------------------------
# AI Agent СЃРїРµС†РёС„РёС‡РЅС‹Рµ РЅР°СЃС‚СЂРѕР№РєРё
# --------------------------------------------

# Р’РєР»СЋС‡РёС‚СЊ fallback СЂРµР¶РёРј РїСЂРё РѕС€РёР±РєР°С… API (true/false)
# РџСЂРё true - Р±СѓРґРµС‚ РІРѕР·РІСЂР°С‰Р°С‚СЊ РїСЂРѕСЃС‚РѕР№ РїРѕРёСЃРє РїРѕ РґРѕРєСѓРјРµРЅС‚Р°С†РёРё
AI_FALLBACK_ENABLED=true

# РњР°РєСЃРёРјР°Р»СЊРЅРѕРµ РєРѕР»РёС‡РµСЃС‚РІРѕ СЃРѕРѕР±С‰РµРЅРёР№ РІ РёСЃС‚РѕСЂРёРё РґРёР°Р»РѕРіР°
AI_MAX_HISTORY_LENGTH=20

# Р’РєР»СЋС‡РёС‚СЊ Р»РѕРіРёСЂРѕРІР°РЅРёРµ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ API (true/false)
AI_USAGE_MONITORING=true

# --------------------------------------------
# Р‘РµР·РѕРїР°СЃРЅРѕСЃС‚СЊ
# --------------------------------------------

# Р Р°Р·СЂРµС€РµРЅРЅС‹Рµ РґРѕРјРµРЅС‹ РґР»СЏ CORS (С‡РµСЂРµР· Р·Р°РїСЏС‚СѓСЋ)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# РњР°РєСЃРёРјР°Р»СЊРЅС‹Р№ СЂР°Р·РјРµСЂ Р·Р°РіСЂСѓР¶Р°РµРјРѕРіРѕ С„Р°Р№Р»Р° (MB)
MAX_CONTENT_LENGTH=16

# --------------------------------------------
# Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹Рµ РЅР°СЃС‚СЂРѕР№РєРё
# --------------------------------------------

# Р§Р°СЃРѕРІРѕР№ РїРѕСЏСЃ
TZ=Europe/Moscow

# РЇР·С‹Рє РїСЂРёР»РѕР¶РµРЅРёСЏ
LANG=ru_RU.UTF-8
